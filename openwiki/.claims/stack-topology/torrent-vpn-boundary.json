    {
      "id": "claim_e0193fe424a24fad9b32ff9be7dc66f1",
      "statement": "Gluetun enforces mullvad plus wireguard, the FIREWALL_ENABLED_DISABLING_IT_SHOOTS_YOU_IN_YOUR_FOOT kill switch, a FIREWALL_OUTBOUND_SUBNETS exception built from HOST_IP limited to a /32, DNS_SERVER on with DNS_ADDRESS 127.0.0.1, DNS_KEEP_NAMESERVER off and DNS_UPSTREAM_RESOLVER_TYPE dot.",
