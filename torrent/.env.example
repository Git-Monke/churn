# Example only — `cargo run` generates torrent/.env for you and prompts for the
# WireGuard values. They are written here and nowhere else.

DATA_DIR=/data
PUID=1000
PGID=1000
TZ=Europe/Amsterdam

# mullvad.net → Account → WireGuard config → download zip → any .json
VPN_SERVICE_PROVIDER=mullvad
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
SERVER_COUNTRIES=Netherlands
