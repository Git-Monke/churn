# Example only — `churn` asks which provider you use, collects that provider's
# credentials and writes torrent/.env for you. The credentials are written here
# and nowhere else.

DATA_DIR=/data
PUID=1000
PGID=1000
TZ=Europe/Amsterdam

# Gluetun provider id and protocol. churn writes both; the OpenVPN keys exist
# because Private Internet Access is the one provider without native WireGuard
# support in Gluetun. Everything else runs over WireGuard, which is the default
# because torrent traffic is throughput-bound.
VPN_SERVICE_PROVIDER=mullvad
VPN_TYPE=wireguard

# WireGuard credentials, for every provider except Private Internet Access.
# Each provider's account page generates the key and the interface address;
# `churn` prints the exact steps for the provider you pick.
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=

# OpenVPN credentials, Private Internet Access only. Use the VPN configuration
# username/password (p0000000 / random string), not your account login.
OPENVPN_USER=
OPENVPN_PASSWORD=

# VPN exit location. churn stores the chosen value twice: VPN_LOCATION is the
# provider-neutral key it reads back on a rerun, and the provider's own filter
# key (SERVER_COUNTRIES, or SERVER_REGIONS for Private Internet Access) is what
# Gluetun parses. Both must match the provider: a stale key from the previous
# provider is rejected before the stack starts.
VPN_LOCATION=USA
SERVER_COUNTRIES=USA
# SERVER_REGIONS=US Seattle

# LAN address of this host. Prowlarr (inside the VPN namespace) and
# Sonarr/Radarr (server stack) reach each other through it. churn auto-detects
# this; set it by hand when detection is wrong. It must be a loopback/LAN
# address: it is the only non-VPN destination gluetun's kill switch allows.
HOST_IP=192.168.1.10

# Optional: FlareSolverr sidecar address used by prowlarr-init. It shares
# Gluetun's namespace, so the default is localhost.
# FLARESOLVERR_URL=http://localhost:8191

# Optional: loopback port for the dashboard's VPN status agent. Keep server/.env
# VPN_STATUS_URL in sync if you change it. The port is never exposed on the LAN.
# VPN_STATUS_PORT=8098

# Optional: qbit-watch restarts qBittorrent after Gluetun reconnects to the VPN
# (a stale libtorrent session otherwise leaves DHT at zero nodes and downloads
# at 0%). These tune how often it looks and how long a DHT stall may last.
# QBIT_WATCH_INTERVAL_SECONDS=5
# QBIT_WATCH_DHT_STALL_SECONDS=30
