# Example only — `cargo run` reads the Mullvad zip you point it at and writes
# torrent/.env for you. The WireGuard key is written here and nowhere else.

DATA_DIR=/data
PUID=1000
PGID=1000
TZ=Europe/Amsterdam

# mullvad.net → Account → WireGuard config → download zip → any .conf
VPN_SERVICE_PROVIDER=mullvad
VPN_TYPE=wireguard
# churn records these so reruns can prefill your archive and file choice.
WIREGUARD_ARCHIVE=/home/you/Downloads/mullvad_wireguard_linux_us_all.zip
WIREGUARD_CONFIG=us-atl-wg-001.conf
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
SERVER_COUNTRIES=Netherlands

# LAN address of this host. Prowlarr (inside the VPN namespace) and
# Sonarr/Radarr (server stack) reach each other through it. churn auto-detects
# this; set it by hand when detection is wrong.
HOST_IP=192.168.1.10
