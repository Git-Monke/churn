# Fixture environment for validating the real torrent/docker-compose.yml.
#
# Every value here is fake. `docker compose config` only needs the required
# variables to be present so it can render the file that ships; nothing in this
# file is usable to run a container, and nothing here is a real credential.
#
# The WireGuard key is a syntactically valid (32-byte, base64) placeholder.
DOWNLOAD_DIR=/tmp/churn-vpn-gate-data
MEDIA_DIR=/tmp/churn-vpn-gate-data/media
HOST_IP=127.0.0.1
PUID=1000
PGID=1000
TZ=UTC
SERVER_COUNTRIES=
WIREGUARD_ADDRESSES=10.64.0.2/32
WIREGUARD_PRIVATE_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
