# OpenVPN fixture for validating the real torrent/docker-compose.yml.
#
# Same contract as fixture.env: every value is fake, and nothing here can start
# a usable tunnel. This one exists so the openvpn credential path — Private
# Internet Access, the only provider Gluetun has no native WireGuard support for
# — is rendered and validated too. SERVER_COUNTRIES is deliberately empty: PIA
# takes SERVER_REGIONS, and a stale country key is exactly what
# src/security.rs must reject.
DOWNLOAD_DIR=/tmp/churn-vpn-gate-data
MEDIA_DIR=/tmp/churn-vpn-gate-data/media
HOST_IP=127.0.0.1
PUID=1000
PGID=1000
TZ=UTC
VPN_SERVICE_PROVIDER=private internet access
VPN_TYPE=openvpn
OPENVPN_USER=p0000000
OPENVPN_PASSWORD=fixture-not-a-real-password
SERVER_REGIONS=US Seattle
