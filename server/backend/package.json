{
  "name": "@churn/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "PORT=${PORT:-4001} CHURN_PASSKEY_ORIGIN=${CHURN_PASSKEY_ORIGIN:-http://localhost:5173} tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "api:generate": "tsx scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^8.0.3",
    "@simplewebauthn/server": "^13.3.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "ajv": "^8.20.0",
    "ts-json-schema-generator": "^2.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
