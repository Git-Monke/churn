# Example only — `cargo run` generates server/.env for you.
#
# PUID/PGID are the owner of DATA_DIR; TZ is detected from the host.
DATA_DIR=/data
PUID=1000
PGID=1000
TZ=Europe/Amsterdam
# Pinned by churn to the release image. Override with a local tag to test a
# development build, for example churn-dashboard:dev.
# CHURN_DASHBOARD_IMAGE=ghcr.io/git-monke/churn-dashboard:0.1.0

# Optional web dashboard settings. Churn preserves hand-added keys when it
# reruns. Sonarr/Radarr API keys are read automatically from
# server/config/<app>/config.xml unless set explicitly here.
# HOST=127.0.0.1
# PORT=4000
# Writable directory for profiles and persisted sessions. The container uses
# /app/state (the churn-state volume); the dev default is server/.churn-state.
# CHURN_STATE_DIR=/app/state
# Server-side idle session TTL. Sessions slide on activity and survive restarts.
# CHURN_SESSION_TTL_MS=43200000
# JELLYFIN_URL=http://127.0.0.1:8096
# Browser-facing Jellyfin URL for video streams. By default it follows the
# hostname used to open Churn (LAN IP, Tailscale IP or MagicDNS), falling back
# to this host's LAN address. Set it for a reverse proxy or TLS name;
# CHURN_HOST_IP overrides only the LAN fallback detection.
# JELLYFIN_PUBLIC_URL=
# Written by churn after it completes Jellyfin setup.
# JELLYFIN_API_KEY=
# Optional, for non-interactive setup. The password is not written back to .env.
# JELLYFIN_ADMIN_USER=admin
# JELLYFIN_ADMIN_PASSWORD=
# SONARR_URL=http://127.0.0.1:8989
# SONARR_API_KEY=
# RADARR_URL=http://127.0.0.1:7878
# RADARR_API_KEY=
# Prowlarr is used for progressive per-indexer release searches. The API key is
# read from ../torrent/config/prowlarr/config.xml by default.
# PROWLARR_URL=http://127.0.0.1:9696
# PROWLARR_API_KEY=
# REQUEST_TIMEOUT_MS=5000
# Sonarr can take several seconds to answer a lookup on a large library, so
# media search and request-option lookups use a longer timeout.
# SEARCH_TIMEOUT_MS=20000
# Sonarr/Radarr release lookups, such as the episode picker, can be slower than
# normal API calls. Direct season and movie grabs go through qBittorrent.
# RELEASE_TIMEOUT_MS=120000
# Loopback address of the torrent stack's VPN status agent, used by the
# Services → VPN tab. The agent runs external checks, so its timeout is longer.
# VPN_STATUS_URL=http://127.0.0.1:8098
# VPN_STATUS_TIMEOUT_MS=25000
