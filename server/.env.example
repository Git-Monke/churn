# Example only — `cargo run` generates server/.env for you.
#
# PUID/PGID are the owner of DATA_DIR; TZ is detected from the host.
DATA_DIR=/data
PUID=1000
PGID=1000
TZ=Europe/Amsterdam

# Optional web dashboard settings. Churn does not write these yet; it preserves
# hand-added keys when it reruns. Sonarr/Radarr API keys are read automatically
# from server/config/<app>/config.xml unless set explicitly here.
# HOST=127.0.0.1
# PORT=4000
# JELLYFIN_URL=http://127.0.0.1:8096
# Create this in Jellyfin under Dashboard -> API Keys.
# JELLYFIN_API_KEY=
# SONARR_URL=http://127.0.0.1:8989
# SONARR_API_KEY=
# RADARR_URL=http://127.0.0.1:7878
# RADARR_API_KEY=
# REQUEST_TIMEOUT_MS=5000
